PORT=5000

# NODE_ENV=development starts an in-memory MongoDB (mongodb-memory-server),
# so no local mongod is required. Set to "production" to use MONGO_URI instead.
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/autolend

JWT_SECRET=change_me_before_any_shared_deployment

# regtest keeps every address and transaction local to your machine
BITCOIN_NETWORK=regtest

# Bitcoin Core RPC, used by the Rust bridge (autolend-bitcoin)
BITCOIN_RPC_URL=http://127.0.0.1:18443
BITCOIN_RPC_USER=admin
BITCOIN_RPC_PASS=adminpass

# Transaction confirmation checks go through an Esplora-style API.
# The repo does not start one; that endpoint is only used when
# BITCOIN_ENFORCE_ONCHAIN=true. Keep it false for local RegTest.
BITCOIN_API_BASE_URL=http://127.0.0.1:3006/api
BITCOIN_REQUIRED_CONFIRMATIONS=1
BITCOIN_ENFORCE_ONCHAIN=false

BTC_USD_REFERENCE_RATE=65000
